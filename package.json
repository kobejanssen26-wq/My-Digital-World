{
  "name": "my-digital-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:worker": "npm -w @mdw/worker run dev",
    "dev:web": "npm -w @mdw/web run dev",
    "build": "npm -w @mdw/web run build && npm -w @mdw/bridge run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "export": "node scripts/export-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
