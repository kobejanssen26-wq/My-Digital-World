# No secrets live in this repository. Placeholders only.

# --- Deploying (scripts/deploy.mjs, GitHub Actions) ---
CLOUDFLARE_API_TOKEN=replace-me   # token with: Workers Scripts:Edit, D1:Edit, R2:Edit (+ Zone:Edit/DNS for a custom domain)
CLOUDFLARE_ACCOUNT_ID=replace-me
MDW_DOMAIN=                       # optional, e.g. world.example.com (zone must be on this Cloudflare account)

# --- Dashboard password ---
# Not an env var: run `npm run setup:secrets -- --local` (writes apps/worker/.dev.vars) or `-- --remote` (Cloudflare secret).

# --- Local bridge (your computer) ---
# Normally written by `mdw-bridge init` to ~/.mdw/config.json (mode 0600). Optional overrides:
MDW_HOME=                         # use a separate data dir for development so real activity is never mixed with test data
MDW_TOKEN=                        # bridge credential (mdw_...) for `mdw-bridge init` in scripts
MDW_PORT=47615                    # loopback status/wake port

# --- Browser E2E script ---
MDW_URL=http://127.0.0.1:8787
MDW_PASSWORD=replace-me
